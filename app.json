{
  "expo": {
    "name": "FreeJob",
    "slug": "freejob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freejob",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.freejob.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "ge.freejob.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5B42F5",
        "foregroundImage": "./assets/images/adaptive_foreground.png",
        "monochromeImage": "./assets/images/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B42F5",
          "image": "./assets/images/adaptive_foreground.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "მიკროფონზე წვდომა საჭიროა ხმოვანი შეტყობინებისთვის"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
